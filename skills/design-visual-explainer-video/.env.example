# Explainer video skill settings.
# Copy to .env in this skill folder (shared defaults) or in a job folder (per-video overrides).
# Precedence: real environment variables > <job>/.env > <skill>/.env > the defaults shown here.
# Never commit .env.

# --- Required -------------------------------------------------------------
# OpenRouter key: https://openrouter.ai/settings/keys
# Tip: create a dedicated key with a credit limit (e.g. $10). The limit is the hard stop.
OPENROUTER_API_KEY=

# --- Budget ---------------------------------------------------------------
# Max USD of API calls per job (images + voice + music). Scripts stop before passing it.
# Does not include the agent's own model tokens.
EXPLAINER_BUDGET_USD=10

# --- Output ---------------------------------------------------------------
# Where deliver.mjs copies the finished video. Leave empty to be asked each time.
EXPLAINER_OUTPUT_DIR=

# --- Images (OpenRouter /api/v1/images) -------------------------------------
EXPLAINER_IMAGE_MODEL=google/gemini-3.1-flash-image
EXPLAINER_IMAGE_FALLBACK_MODEL=google/gemini-2.5-flash-image
# 512 | 1K | 2K | 4K  (1K is enough for sprites on a 1080p canvas)
EXPLAINER_IMAGE_RESOLUTION=1K
EXPLAINER_IMAGE_CONCURRENCY=3

# --- Voice ----------------------------------------------------------------
# openrouter | elevenlabs | edge (free, unofficial endpoint) | silent (animatic)
EXPLAINER_TTS_PROVIDER=openrouter
EXPLAINER_TTS_MODEL=google/gemini-3.8-flash-tts
EXPLAINER_TTS_VOICE=Charon
# Delivery style for Gemini voices (lines.json "voice.style" overrides this)
EXPLAINER_TTS_STYLE=
# 1 = natural pace. Only some models support speed.
EXPLAINER_TTS_SPEED=1

# Only when EXPLAINER_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Music ----------------------------------------------------------------
# openrouter (Lyria) | synth (built-in, free) | file | none
EXPLAINER_MUSIC_PROVIDER=openrouter
EXPLAINER_MUSIC_MODEL=google/lyria-3-pro-preview
# Only when EXPLAINER_MUSIC_PROVIDER=file: a track you have the rights to use
EXPLAINER_MUSIC_FILE=

# --- Mix ------------------------------------------------------------------
EXPLAINER_TARGET_LUFS=-16
EXPLAINER_TRUE_PEAK=-1.5
# How far (dB) the music sits under the voice during speech
EXPLAINER_MUSIC_UNDER_VOICE_DB=16
EXPLAINER_SFX_GAIN=0.8

# --- Video ----------------------------------------------------------------
# 1920x1080 landscape; 1080x1920 for vertical (Shorts/Reels/TikTok)
EXPLAINER_WIDTH=1920
EXPLAINER_HEIGHT=1080
EXPLAINER_FPS=30
EXPLAINER_CRF=20
# Bitrate cap keeps a 60 s video around 60 MB (shareable in chat apps)
EXPLAINER_MAXRATE=8M
# 0 = auto (half the CPU cores, max 4)
EXPLAINER_RENDER_WORKERS=0

# --- Language and fonts ---------------------------------------------------
EXPLAINER_LANGUAGE=en
# Google Fonts subsets to embed: latin,latin-ext | cyrillic | greek | vietnamese | all
EXPLAINER_FONT_SUBSETS=latin,latin-ext

# --- Tools (optional overrides) -------------------------------------------
# Use an installed browser instead of Playwright's download
EXPLAINER_CHROME_PATH=
# Use a system ffmpeg instead of ffmpeg-static
EXPLAINER_FFMPEG_PATH=

# --- OpenRouter attribution (optional) --------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
